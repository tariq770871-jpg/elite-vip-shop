# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, but .env.example IS committable
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Internal logs / multi-agent worklog (must never be committed)
WORKLOG.md
worklog.md
worklog/
agent-ctx/

# Cleanup artifacts
scripts/_cleanup/

# Server config (kept locally, deployed via infra)
Caddyfile

# Tool result snapshots
tool-results/
.tool-results/

# Lock files
bun.lock

# Local audit / download artifacts (never commit)
/test-results/
/playwright-report/
audit-remote/
download/
upload/

# Temporary scripts (one-time audit/debug)
scripts/check_pages.py
scripts/generate_project_report.py
scripts/generate_report_main.py
scripts/report_sections_part1.py
scripts/report_sections_part2.py
