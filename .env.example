# ============================================================
# Elite VIP Shop — Environment Variables Template
# ============================================================
# Copy this file to .env.local (development) or set in Vercel
# dashboard → Settings → Environment Variables (production).
#
# NEVER commit the real .env file — it contains secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-only.
# ============================================================

# ─── REQUIRED (Application will not boot in production without these) ───

# Supabase project URL (e.g., https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anonymous key — safe for browser (RLS-enforced)
# Format (new): sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Format (legacy): eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Supabase service role key — SERVER-ONLY, never expose to browser
# Bypasses RLS — use only in trusted server contexts (middleware, admin APIs)
# Format (new): sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# ─── STRONGLY RECOMMENDED ────────────────────────────────────────────────

# Public site URL (used for SEO canonical URLs, OG tags, sitemap, CSRF origin check)
# In Vercel: set to your production domain (e.g., https://elite-vip-shop.vercel.app)
NEXT_PUBLIC_SITE_URL=https://elite-vip-shop.vercel.app

# ─── OPTIONAL — Telegram admin notifications ─────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram chat ID where new order notifications are sent
# Get your chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=000000000

# ─── OPTIONAL — Analytics & SEO ──────────────────────────────────────────

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification code
# NEXT_PUBLIC_GSC_VERIFICATION=your_verification_code

# ─── OPTIONAL — Direct DB access (scripts only, never used by the app) ────

# Supabase database password — used ONLY by scripts/run-full-migration.mjs
# for direct PostgreSQL connection. Not used by the Next.js app itself.
# SUPABASE_DB_PASSWORD=your_db_password

# ─── OPTIONAL — WhatsApp floating button ─────────────────────────────────

# WhatsApp contact number (international format without +)
# NEXT_PUBLIC_WHATSAPP_NUMBER=967700000000

# ─── OPTIONAL — Mini-service auth (mini-services/telegram-bot/) ───────────

# Bearer token required by mini-services/telegram-bot endpoints
# Generate with: openssl rand -hex 32
# MINI_SERVICE_BEARER_TOKEN=replace_with_random_64_hex_chars
